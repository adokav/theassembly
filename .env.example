# =========================================================
#  The Assembly Bot — Ortam Değişkenleri (tek doğru liste)
#  Render'da HEPSİ servisin KENDİ "Environment Variables"
#  bölümünde, aynı listede olmalı (XAI_API_KEY'in durduğu yer).
# =========================================================

# --- ZORUNLU ---
TELEGRAM_TOKEN=            # BotFather'dan alınan token
RSS_URL=                  # X hesabının RSS adresi (Nitter / RSSHub)

# --- LLM SAĞLAYICI (Groq — ücretsiz) ---
LLM_API_KEY=             # console.groq.com -> API Keys -> gsk_...
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- ÇOKLU HESAP ---
# En kolayı: bir şablon tanımla; her hesabın feed'i handle'dan üretilir.
# RSS_TEMPLATE=https://NITTER_ADRESIN/{handle}/rss
#   (örn. RSSHub: https://RSSHUB_ADRESIN/twitter/user/{handle})
# Şablon varsa yeni hesap eklemek için kodda _ACCOUNT_DEFS'e tek satır yeter.
#
# Alternatif: her hesaba ayrı URL ver
# BORA_RSS_URL=https://.../BoraOzkent/rss

# --- OPSİYONEL ---
# RSS_FALLBACK_URLS=https://mirror1/feed,https://mirror2/feed   # The Assembly için yedek aynalar
# PORT=                  # Render OTOMATİK atar — elle EKLEME

# --- ARTIK GEREKMEYENLER (Render'dan SİLİNEBİLİR) ---
# XAI_API_KEY=           # Groq'a geçtik; gerekmiyor
# OPENAI_API_KEY=        # kullanılmıyor
# CHAT_ID=               # kod bunu kullanmıyor


# =========================================================
#  KRİPTO SİNYAL BOTU (crypto_bot.py) — ayrı uygulama
#  Çalıştırma: python crypto_bot.py
#  Sadece TELEGRAM_TOKEN zorunlu; piyasa verisi anahtarsız
#  (Binance public API + alternative.me) çekilir.
# =========================================================
# TELEGRAM_TOKEN=        # (yukarıdakiyle aynı; BotFather token'ı)
# DEFAULT_SYMBOLS=BTC,ETH,SOL        # watchlist'i boş olanlar için varsayılan
# QUOTE_ASSET=USDT                    # işlem çifti karşılığı (BTCUSDT)
# SCAN_INTERVAL_MIN=30                # periyodik tarama sıklığı (dakika)
# ALERT_SCORE_THRESHOLD=0.35          # alarm eşiği (0-1)
# DB_PATH=crypto_signals.db           # SQLite dosya yolu
# BINANCE_BASE=https://api.binance.com  # gerekirse ayna/proxy
