# =========================================================
#  The Assembly Bot — Ortam Değişkenleri (tek doğru liste)
#  Render'da HEPSİ servisin KENDİ "Environment Variables"
#  bölümünde, aynı listede olmalı (XAI_API_KEY'in durduğu yer).
# =========================================================

# --- ZORUNLU ---
TELEGRAM_TOKEN=            # BotFather'dan alınan token
RSS_URL=                  # X hesabının RSS adresi (Nitter / RSSHub)

# --- LLM SAĞLAYICI (Groq — ücretsiz) ---
LLM_API_KEY=             # console.groq.com -> API Keys -> gsk_...
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- OPSİYONEL ---
# RSS_FALLBACK_URLS=https://mirror1/feed,https://mirror2/feed   # yedek RSS aynaları
# PORT=                  # Render OTOMATİK atar — elle EKLEME

# --- ARTIK GEREKMEYENLER (Render'dan SİLİNEBİLİR) ---
# XAI_API_KEY=           # Groq'a geçtik; gerekmiyor
# OPENAI_API_KEY=        # kullanılmıyor
# CHAT_ID=               # kod bunu kullanmıyor
